# NGO Intelligence Verification Pipeline Environment Configuration Example
# Copy this file to .env and configure as needed.

# LLM Provider ('auto', 'ollama', or 'mock')
# 'auto' pings Ollama at OLLAMA_HOST and falls back to deterministic local mock if offline
LLM_PROVIDER=auto

# Ollama Host & Port (Local, zero-cost inference)
OLLAMA_HOST=http://localhost:11434

# Target Local Model (e.g. qwen2.5:7b, llama3.1:8b, qwen2.5:14b)
OLLAMA_MODEL=qwen2.5:7b

# Inference Temperature (0.0 strictly recommended for factual reproducibility)
LLM_TEMPERATURE=0.0

# LLM Timeout in Seconds
LLM_TIMEOUT_SECONDS=45

# Verification Rules
MIN_INDEPENDENT_DOMAINS=2
RECENCY_WINDOW_HOURS=72

# Database Storage Path
DB_PATH=data/ngo_pipeline.db
